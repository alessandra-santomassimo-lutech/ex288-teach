{
  "kind": "Template",
  "apiVersion": "template.openshift.io/v1",
  "metadata": {
    "name": "hello-db",
    "annotations": {
      "openshift.io/display-name": "Hello Node + PostgreSQL (immagine esistente)",
      "description": "Esegue un'immagine hello-node GIA' COSTRUITA insieme a un database PostgreSQL effimero. Template pre-esistente in formato JSON del modulo 09.",
      "tags": "nodejs,postgresql,ex288",
      "iconClass": "icon-nodejs"
    }
  },
  "message": "Applicazione ${APP_NAME} creata con l'immagine ${APP_IMAGE}. Password del database: ${DB_PASSWORD}",
  "labels": {
    "template": "hello-db"
  },
  "parameters": [
    {
      "name": "APP_NAME",
      "displayName": "Nome applicazione",
      "description": "Nome di tutti gli oggetti; il database usa il suffisso -db",
      "value": "hello",
      "required": true
    },
    {
      "name": "APP_IMAGE",
      "displayName": "Immagine dell'applicazione",
      "description": "Riferimento completo all'immagine, es. image-registry.openshift-image-registry.svc:5000/<progetto>/hello-node:latest",
      "required": true
    },
    {
      "name": "APP_MESSAGE",
      "displayName": "Messaggio dell'applicazione",
      "value": "Ciao da un template JSON!"
    },
    {
      "name": "REPLICAS",
      "displayName": "Repliche dell'applicazione",
      "value": "1"
    },
    {
      "name": "POSTGRES_IMAGE",
      "displayName": "Immagine PostgreSQL",
      "value": "registry.redhat.io/rhel9/postgresql-16"
    },
    {
      "name": "DB_NAME",
      "displayName": "Nome del database",
      "value": "hellodb"
    },
    {
      "name": "DB_USER",
      "displayName": "Utente del database",
      "value": "hello"
    },
    {
      "name": "DB_PASSWORD",
      "displayName": "Password del database",
      "description": "Generata se non specificata",
      "generate": "expression",
      "from": "[a-zA-Z0-9]{16}"
    }
  ],
  "objects": [
    {
      "apiVersion": "v1",
      "kind": "Secret",
      "metadata": {
        "name": "${APP_NAME}-db",
        "labels": {
          "app": "${APP_NAME}"
        }
      },
      "type": "Opaque",
      "stringData": {
        "database-name": "${DB_NAME}",
        "database-user": "${DB_USER}",
        "database-password": "${DB_PASSWORD}"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "${APP_NAME}-config",
        "labels": {
          "app": "${APP_NAME}"
        }
      },
      "data": {
        "app.properties": "app.name=${APP_NAME}\ndb.host=${APP_NAME}-db\norigine=template hello-db (JSON)\n"
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "${APP_NAME}",
        "labels": {
          "app": "${APP_NAME}",
          "app.kubernetes.io/component": "frontend"
        }
      },
      "spec": {
        "replicas": "${{REPLICAS}}",
        "selector": {
          "matchLabels": {
            "deployment": "${APP_NAME}"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "${APP_NAME}",
              "deployment": "${APP_NAME}"
            }
          },
          "spec": {
            "containers": [
              {
                "name": "hello-node",
                "image": "${APP_IMAGE}",
                "ports": [
                  {
                    "name": "http",
                    "containerPort": 8080
                  }
                ],
                "env": [
                  {
                    "name": "APP_MESSAGE",
                    "value": "${APP_MESSAGE}"
                  },
                  {
                    "name": "DB_HOST",
                    "value": "${APP_NAME}-db"
                  },
                  {
                    "name": "DB_PORT",
                    "value": "5432"
                  },
                  {
                    "name": "DB_NAME",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "${APP_NAME}-db",
                        "key": "database-name"
                      }
                    }
                  },
                  {
                    "name": "DB_USER",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "${APP_NAME}-db",
                        "key": "database-user"
                      }
                    }
                  },
                  {
                    "name": "DB_PASSWORD",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "${APP_NAME}-db",
                        "key": "database-password"
                      }
                    }
                  }
                ],
                "readinessProbe": {
                  "httpGet": {
                    "path": "/ready",
                    "port": 8080
                  },
                  "periodSeconds": 5
                },
                "livenessProbe": {
                  "httpGet": {
                    "path": "/healthz",
                    "port": 8080
                  },
                  "initialDelaySeconds": 10
                },
                "volumeMounts": [
                  {
                    "name": "config",
                    "mountPath": "/etc/app",
                    "readOnly": true
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "config",
                "configMap": {
                  "name": "${APP_NAME}-config"
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "${APP_NAME}",
        "labels": {
          "app": "${APP_NAME}"
        }
      },
      "spec": {
        "selector": {
          "deployment": "${APP_NAME}"
        },
        "ports": [
          {
            "name": "http",
            "port": 8080,
            "targetPort": 8080
          }
        ]
      }
    },
    {
      "apiVersion": "route.openshift.io/v1",
      "kind": "Route",
      "metadata": {
        "name": "${APP_NAME}",
        "labels": {
          "app": "${APP_NAME}"
        }
      },
      "spec": {
        "to": {
          "kind": "Service",
          "name": "${APP_NAME}"
        },
        "port": {
          "targetPort": "http"
        },
        "tls": {
          "termination": "edge",
          "insecureEdgeTerminationPolicy": "Redirect"
        }
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "${APP_NAME}-db",
        "labels": {
          "app": "${APP_NAME}",
          "app.kubernetes.io/component": "database"
        }
      },
      "spec": {
        "replicas": 1,
        "strategy": {
          "type": "Recreate"
        },
        "selector": {
          "matchLabels": {
            "deployment": "${APP_NAME}-db"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "${APP_NAME}",
              "deployment": "${APP_NAME}-db"
            }
          },
          "spec": {
            "containers": [
              {
                "name": "postgresql",
                "image": "${POSTGRES_IMAGE}",
                "ports": [
                  {
                    "name": "postgresql",
                    "containerPort": 5432
                  }
                ],
                "env": [
                  {
                    "name": "POSTGRESQL_DATABASE",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "${APP_NAME}-db",
                        "key": "database-name"
                      }
                    }
                  },
                  {
                    "name": "POSTGRESQL_USER",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "${APP_NAME}-db",
                        "key": "database-user"
                      }
                    }
                  },
                  {
                    "name": "POSTGRESQL_PASSWORD",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "${APP_NAME}-db",
                        "key": "database-password"
                      }
                    }
                  }
                ],
                "readinessProbe": {
                  "tcpSocket": {
                    "port": 5432
                  },
                  "initialDelaySeconds": 5
                },
                "volumeMounts": [
                  {
                    "name": "data",
                    "mountPath": "/var/lib/pgsql/data"
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "data",
                "emptyDir": {}
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "${APP_NAME}-db",
        "labels": {
          "app": "${APP_NAME}"
        }
      },
      "spec": {
        "selector": {
          "deployment": "${APP_NAME}-db"
        },
        "ports": [
          {
            "name": "postgresql",
            "port": 5432,
            "targetPort": 5432
          }
        ]
      }
    }
  ]
}
