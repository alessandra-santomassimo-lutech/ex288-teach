{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Valori di hello-chart",
  "type": "object",
  "properties": {
    "fullnameOverride": { "type": "string" },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "object",
          "properties": {
            "repository": { "type": "string" },
            "tag": { "type": "string" },
            "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "replicas": { "type": "integer", "minimum": 0 },
        "message": { "type": "string" },
        "readyDelaySeconds": { "type": "integer", "minimum": 0 },
        "config": { "type": "string" },
        "resources": { "type": "object" }
      }
    },
    "route": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "host": { "type": "string" }
      }
    },
    "db": {
      "type": "object",
      "required": ["password"],
      "properties": {
        "image": { "type": "string" },
        "name": { "type": "string" },
        "user": { "type": "string" },
        "password": { "type": "string", "minLength": 1 },
        "persistence": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "size": { "type": "string" },
            "storageClass": { "type": "string" }
          }
        }
      }
    }
  }
}
